{
  "name": "procurement-control-center",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app lib features scripts tests vitest.config.mts --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node tests/sql/payment-flow.mjs && node tests/sql/paginated-lists.mjs && node tests/sql/w119-numbering.mjs && node tests/sql/w804-registry.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run format:check && npm run build",
    "vendors:import": "node scripts/import-vendors.mjs",
    "vendors:sql": "node scripts/import-vendors.mjs --sql-file"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "next": "^16.3.6",
    "pdf-lib": "1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
